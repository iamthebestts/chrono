{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "tests",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/tests.ps1",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "analyze",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/analyze.ps1",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "install",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}